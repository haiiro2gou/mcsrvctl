{
    "compilerOptions": {
        /* Project */
        "target": "ES2022",
        "lib": ["ES2022"],

        /* Module */
        "module": "node16",
        "rootDir": "src",
        "moduleResolution": "node16",
        "types": ["node"],

        /* Output */
        "noEmit": true,

        /* Interop */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Linting */
        "skipLibCheck": true,
        "strict": true,
    },
    "include": ["src"],
}