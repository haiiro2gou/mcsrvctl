{
  "name": "mcsrvctl",
  "version": "2.0.0",
  "description": "Enables to boot Minecraft servers from Discord!",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "clean": "rimraf dist/* --glob",
    "tsc": "tsc -p tsconfig.build.json",
    "build": "npm-run-all clean tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src/**/*.ts",
    "eslint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "lint": "npm-run-all eslint check-types",
    "lint:fix": "npm-run-all eslint:fix check-types format",
    "prepare": "husky"
  },
  "author": "haiiro2gou <mrashen.2gou@gmail.com>",
  "license": "MIT License",
  "homepage": "https://github.com/haiiro2gou/mcsrvctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haiiro2gou/mcsrvctl.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@haiiro2gou/eslint-config": "^2.0.0",
    "@types/node": "^22.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@kubernetes/client-node": "~1.4.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "minecraft-status": "^1.1.0",
    "node-cron": "^4.5.0"
  },
  "overrides": {
    "undici": "^7.22.0"
  },
  "imports": {
    "#lib/*.js": "./dist/lib/*.js",
    "#features/*.js": "./dist/features/*.js",
    "#utils/*.js": "./dist/utils/*.js"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.ts": "bash -c 'tsc --noEmit'",
    "*.{js,ts,json}": "prettier --write",
    "*.js": "eslint --cache --fix"
  }
}
