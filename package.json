{
  "name": "mcsrvctl",
  "version": "2.0.0",
  "private": true,
  "description": "Enables to boot Minecraft servers from Discord!",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "start": "node dist/index.js",
    "clean": "rimraf dist/* --glob",
    "tsc": "tsc -p tsconfig.build.json",
    "build": "npm-run-all clean tsc",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src/**/*.ts",
    "eslint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "lint": "npm-run-all eslint check-types",
    "lint:fix": "npm-run-all eslint:fix check-types format",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate"
  },
  "author": "haiiro2gou <mrashen.2gou@gmail.com>",
  "license": "MIT License",
  "homepage": "https://github.com/haiiro2gou/mcsrvctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haiiro2gou/mcsrvctl.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@haiiro2gou/eslint-config": "2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.4.0",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.4",
    "minecraft-status": "1.1.0"
  },
  "overrides": {
    "undici": "^7.22.0"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.ts": "bash -c 'tsc --noEmit'",
    "*.{js,ts,json}": "prettier --write",
    "*.js": "eslint --cache --fix"
  },
  "allowScripts": {
    "esbuild@0.18.20": false,
    "esbuild@0.25.12": false,
    "esbuild@0.28.2": false,
    "better-sqlite3": false,
    "unrs-resolver": false
  }
}
