{
  "name": "mcsrvctl",
  "version": "2.0.0",
  "description": "Enables to boot Minecraft servers from Discord!",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src/**/*.ts",
    "eslint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "lint": "npm-run-all eslint check-types",
    "lint:fix": "npm-run-all eslint:fix check-types format",
    "prepare": "husky"
  },
  "author": "haiiro2gou <mrashen.2gou@gmail.com>",
  "license": "MIT License",
  "homepage": "https://github.com/haiiro2gou/mcsrvctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haiiro2gou/mcsrvctl.git"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.4",
    "@haiiro2gou/eslint-config": "^1.3.2",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@kubernetes/client-node": "~1.4.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "minecraft-status": "^1.1.0",
    "node-cron": "^4.5.0"
  },
  "overrides": {
    "undici": "^7.22.0"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.ts": "bash -c 'tsc --noEmit'",
    "*.{js,ts,json}": "prettier --write",
    "*.js": "eslint --cache --fix"
  }
}
